# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
# On Replit these were injected automatically from the Secrets panel. Locally
# nothing sets them, so Vite reads them from `.env` in this directory.

# Clerk publishable key. MUST be a development key (starts with `pk_test_`).
#
# Why development specifically: src/App.tsx calls publishableKeyFromHost(), which
# returns your key verbatim ONLY if it is a dev key. Given a production key
# (`pk_live_`) or nothing at all, it instead derives a key from the browser
# hostname — on localhost that becomes `clerk.localhost`, which does not exist,
# and Clerk fails to load with `failed_to_load_clerk_js`.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Clerk proxy URL. Leave EMPTY for local development — Clerk talks to its
# development frontend API directly. Replit sets this automatically in
# production; setting it locally will break sign-in.
VITE_CLERK_PROXY_URL=
