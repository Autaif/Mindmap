# Copy this file to `.env` and fill in the values. `.env` is gitignored, so it
# does NOT travel between machines via GitHub — you recreate it on each machine.
#
# On Replit these were injected from the Secrets panel. Locally nothing sets
# them, so Vite reads them from `.env` in this directory.

# --- Supabase (REQUIRED — this is what the web app actually uses) ----------
#
# Where to get these: https://supabase.com/dashboard -> your project ->
# Project Settings -> API. Copy "Project URL" and the "anon / public" key.
#
# The anon key is designed to be visible in the browser and already ships in
# the deployed bundle — Row Level Security is what protects the data, not this
# key. Never put the `service_role` key here; it bypasses RLS entirely.
VITE_SUPABASE_URL=https://replace_me.supabase.co
VITE_SUPABASE_ANON_KEY=replace_me

# --- Clerk (NOT used by the web app any more) ------------------------------
#
# The web app moved to Supabase for accounts and no longer reads these; they
# are kept only because `artifacts/mindmap-mobile` still targets Clerk plus
# `artifacts/api-server`. You can leave them untouched for web-only work.
#
# If you do wire Clerk up: the key MUST be a development key (`pk_test_`).
# src/App.tsx calls publishableKeyFromHost(), which returns your key verbatim
# ONLY if it is a dev key. Given a production key (`pk_live_`) or nothing, it
# derives one from the browser hostname — on localhost that becomes
# `clerk.localhost`, which does not exist, and Clerk fails to load with
# `failed_to_load_clerk_js`.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Clerk proxy URL. Leave EMPTY for local development. Replit sets this in
# production; setting it locally will break sign-in.
VITE_CLERK_PROXY_URL=
